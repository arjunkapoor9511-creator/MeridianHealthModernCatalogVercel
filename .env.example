# Copy to .env.local and fill in. .env.local is gitignored.
# These must ALSO be set in the Vercel project (Development, Preview, Production).

# --- Azure products API ---
# GET {AZURE_PRODUCTS_URL}?insurance=<unitedhealthcare|humana> with header x-functions-key
AZURE_PRODUCTS_URL=
AZURE_PRODUCTS_KEY=

# --- Demo auth ---
# Signs the mm_session demo JWT (HS256). Must be >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Absolute URL of the MeridianHealth storefront. proxy.ts redirects
# unauthenticated visitors here. (Azure Blob static website hosting.)
MARKETPLACE_ENTRY_URL=https://meridiandatastore.z19.web.core.windows.net/index.html

# Origin of the legacy marketplace fork. proxy.ts transparently rewrites
# not-yet-migrated insurance cohorts here.
LEGACY_ORIGIN=https://meridianlegacy.z13.web.core.windows.net

# --- Cohort routing (Vercel Global Config) ---
# Connection string for the Global Config that holds the routing table
# (migratedCohorts / cohortOverrides / killSwitch). Auto-injected by Vercel when
# the store is connected; `vercel env pull` brings it local.
# Edit the routing table in the Vercel dashboard (Storage -> Global Config ->
# Items); `node scripts/cohort.mjs` shows the current state (read-only).
GLOBAL_CONFIG=
