# Copy to .env.local and fill in. .env.local is gitignored.
# These must ALSO be set in the Vercel project (Development, Preview, Production).

# --- Azure products API ---
# GET {AZURE_PRODUCTS_URL}?insurance=<unitedhealthcare|humana> with header x-functions-key
AZURE_PRODUCTS_URL=
AZURE_PRODUCTS_KEY=
# GET {AZURE_PRODUCT_DETAIL_URL}?sku=<SKU> with header x-functions-key (reuses AZURE_PRODUCTS_KEY).
# Same function app as AZURE_PRODUCTS_URL, path /api/productdetail. Backs the detail popup.
AZURE_PRODUCT_DETAIL_URL=

# --- Azure AI Search (catalog chatbot retrieval) ---
# Hybrid vector + keyword search over the product index. The index has an
# integrated vectorizer, so the chatbot sends query text and Azure embeds it.
# Endpoint: https://<service>.search.windows.net   Index: the product index name.
# Key: a QUERY key (read-only), not the admin key.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_KEY=

# --- Catalog chatbot ---
# Shown in the fixed out-of-scope deflection line:
# "This query is currently out of scope, please contact support on <this>".
CHAT_SUPPORT_CONTACT=support@meridianhealth.example
# Optional model overrides (default: claude-sonnet-5 agent / claude-haiku-4.5
# classifier / gpt-5.4 gateway failover). Drop to cheaper slugs if needed.
# CHAT_MODEL=
# CHAT_SCOPE_MODEL=
# CHAT_FALLBACK_MODEL=
# AI Gateway auth. On Vercel, OIDC (VERCEL_OIDC_TOKEN, auto-injected / `vercel env
# pull`) is used automatically and this can stay empty. Set a static gateway key
# only for environments without OIDC (some CI). Enable AI Gateway on the project.
AI_GATEWAY_API_KEY=

# --- Demo auth ---
# Signs the mm_session demo JWT (HS256). Must be >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Absolute URL of the MeridianHealth storefront. proxy.ts redirects
# unauthenticated visitors here. (Azure Blob static website hosting.)
MARKETPLACE_ENTRY_URL=https://meridiandatastore.z19.web.core.windows.net/index.html

# Origin of the legacy marketplace fork. proxy.ts transparently rewrites
# not-yet-migrated insurance cohorts here.
LEGACY_ORIGIN=https://meridianlegacy.z13.web.core.windows.net

# --- Cohort routing (Vercel Global Config) ---
# Connection string for the Global Config that holds the routing table
# (migratedCohorts / cohortOverrides / killSwitch). Auto-injected by Vercel when
# the store is connected; `vercel env pull` brings it local.
# Edit the routing table in the Vercel dashboard (Storage -> Global Config ->
# Items); `node scripts/cohort.mjs` shows the current state (read-only).
GLOBAL_CONFIG=
